{
  "name": "developer-control-room",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "build": "tsc --noEmit && vite build",
    "start": "tsx apps/service/src/server.ts",
    "desktop": "npm run build && electron apps/desktop/main.cjs",
    "cli": "tsx apps/cli/src/index.ts",
    "demo": "tsx examples/demo-app/server.ts",
    "setup:demo": "tsx apps/cli/src/index.ts demo",
    "test": "tsx --test tests/*.test.ts",
    "test:gate": "tsx scripts/verify-gate.ts",
    "test:phase2": "tsx scripts/verify-phase2.ts",
    "test:desktop": "tsx scripts/verify-desktop.ts",
    "typecheck": "tsc --noEmit",
    "test:phase34": "tsx scripts/verify-phase34.ts",
    "test:editor": "tsx scripts/verify-editor.ts",
    "package:editor": "tsx scripts/package-editor.ts",
    "package:windows": "npm run build && npm run package:bridge && tsx scripts/package-windows.ts",
    "test:release": "tsx scripts/verify-local-release.ts",
    "package:bridge": "tsx scripts/package-bridge.ts"
  },
  "dependencies": {
    "fflate": "0.8.3",
    "lucide-react": "1.47.0",
    "playwright": "1.63.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript-parser": "npm:typescript@6.0.3",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "electron": "44.4.5",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.0"
  },
  "author": {
    "name": "Haitham Jalal",
    "url": "https://github.com/haithamexe"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/haithamexe/dev-room-control.git"
  },
  "homepage": "https://github.com/haithamexe/dev-room-control#readme",
  "bugs": {
    "url": "https://github.com/haithamexe/dev-room-control/issues"
  }
}
